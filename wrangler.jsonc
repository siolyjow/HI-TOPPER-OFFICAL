{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hi-topper-offical",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",
  "services": [{ "binding": "FATE_BACKEND", "service": "fate-arbiter" }, { "binding": "SITE_STATS", "service": "hitopper-site-stats" }]
}
